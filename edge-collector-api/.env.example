# 仅供本机 docker-compose.dev.yml 开发使用。不要在生产环境复用这些值。
POSTGRES_DB=edge_collector
POSTGRES_USER=edge_collector
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=54329

# 至少使用 32 个随机字符。示例值不能用于生产。
APP_JWT__SECRET=replace-with-a-random-local-development-jwt-secret

# 固定的 DEV ONLY MQTT 主密钥，用于加密数据库中的 MQTT 密码/客户端私钥。
# 同一个本地数据库必须保持该值稳定；不要在生产环境复用。
APP_MQTT__MASTER_SECRET=edge-collector-local-dev-master-secret-v1-do-not-use-in-production

API_PORT=8080
# Optional absolute storage root override; Compose mounts the default path.
# APP_FILE__STORAGE_ROOT=/var/lib/edge-collector-api/uploads
